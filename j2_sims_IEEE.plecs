                    Variable      "OutputFcn"
                    Value         "\n"
"for ( int i=0; i<2; i++)\n"
"{arr[i][0]=Input(i);\n"
"}\n"
"\n"
"for ( int i=0; i<2; i++)\n"
"{arr[i][1]=i;\n"
"}\n"
