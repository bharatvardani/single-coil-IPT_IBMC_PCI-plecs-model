            Variable      "Ts"
            Value         "1/85e3"
            Show          off
          }
          Parameter {
            Variable      "TerminalBasedSampleTimes"
            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "Parameters"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "LangStandard"
            Value         "2"
            Show          off
          }
          Parameter {
            Variable      "GnuExtensions"
            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "RuntimeCheck"
            Value         "2"
            Show          off
          }
          Parameter {
            Variable      "HighlightLevel"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "Declarations"
            Value         "#include <math.h>\n"
"\n"
"#define PI 3.14159265358979323846\n"
"\n"
"static double harmonic_H(double alpha, double Vb, double X2)\n"
"{\n"
"    double H = 0.0;\n"
"    double coeff;\n"
"    double s;\n"
"    int n;\n"
"\n"
"    for (n = 3; n <= 31; n += 2)\n"
"    {\n"
"        coeff = ((double)(n*n - 1))/((double)(n*n*(n*n - 2)));\n"
"        s = sin(n*alpha/2.0);\n"
"        H += coeff*s*s;\n"
"    }\n"
"\n"
"    H = (4.0*Vb/(PI*X2))*H;\n"
"\n"
"    return H;\n"
"}"
            Show          off
          }
          Parameter {
            Variable      "StartFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "OutputFcn"
            Value         "// Inputs from MUX\n"
"double Po   = InputSignal(0,0);   // Output power [W]\n"
"double k    = InputSignal(0,1);   // Coupling factor\n"
"double Vb   = InputSignal(0,2);   // Secondary DC voltage [V]\n"
"double X1   = InputSignal(0,3);   // Primary reactance [ohm]\n"
"double X2   = InputSignal(0,4);   // Secondary reactance [ohm]\n"
"double wLpt = InputSignal(0,5);   // Primary VA reactance [ohm]\n"
"double wLst = InputSignal(0,6);   // Secondary VA reactance [ohm]\n"
"\n"
"double c1 = 2.0*sqrt(2.0)/PI;     // 0.9003\n"
"\n"
"double beta_deg;\n"
"double beta;\n"
"double alpha;\n"
"double alpha_deg;\n"
"\n"
"double S;\n"
"double Ipt1;\n"
"double Ist1;\n"
"\n"
"double Vpi1;\n"
"double Vsi1;\n"
"double Vdc;\n"
"\n"
"double arg;\n"
"double H;\n"
"double ion;\n"
"double ioff;\n"
"\n"
"double best_alpha = 0.0;\n"
"double best_beta  = 0.0;\n"
"double best_Vdc   = 0.0;\n"
"\n"
"// Search beta from 90 degree to 170 degree\n"
"for (beta_deg = 90.0; beta_deg <= 170.0; beta_deg += 0.05)\n"
"{\n"
"    beta = beta_deg*PI/180.0;\n"
"\n"
"    if ((k <= 0.0) || (sin(beta) <= 0.0))\n"
"    {\n"
"        continue;\n"
"    }\n"
"\n"
"    if ((X1 <= 0.0) || (X2 <= 0.0) || (wLpt <= 0.0) || (wLst <= 0.0) || (Vb <"
"= 0.0))\n"
"    {\n"
"        continue;\n"
"    }\n"
"\n"
"    // Equal VA condition:\n"
"    // Po = k*S*sin(beta)\n"
"    // where S = VAp = VAs\n"
"    S = Po/(k*sin(beta));\n"
"\n"
"    if (S <= 0.0)\n"
"    {\n"
"        continue;\n"
"    }\n"
"\n"
"    // Fundamental currents from VA rating\n"
"    Ipt1 = sqrt(S/wLpt);\n"
"    Ist1 = sqrt(S/wLst);\n"
"\n"
"    // Fundamental voltages\n"
"    Vpi1 = X1*Ipt1;\n"
"    Vsi1 = X2*Ist1;\n"
"\n"
"    // Required primary DC voltage\n"
"    // Vpi1 = 0.9003*Vdc\n"
"    Vdc = Vpi1/c1;\n"
"\n"
"    // Three-level secondary fundamental:\n"
"    // Vsi1 = 0.9003*Vb*sin(alpha/2)\n"
"    arg = Vsi1/(c1*Vb);\n"
"\n"
"    if (arg > 1.0)\n"
"    {\n"
"        continue;\n"
"    }\n"
"\n"
"    alpha = 2.0*asin(arg);\n"
"    alpha_deg = alpha*180.0/PI;\n"
"\n"
"    // Harmonic current contribution\n"
"    H = harmonic_H(alpha, Vb, X2);\n"
"\n"
"    // Switching currents\n"
"    ion  = -(sqrt(2.0)*Vpi1/X2)*sin(beta - alpha/2.0) - H;\n"
"    ioff = -(sqrt(2.0)*Vpi1/X2)*sin(beta + alpha/2.0) + H;\n"
"\n"
"    // Select minimum beta where turn-off current is just positive\n"
"    if ((ioff >= 0.0) && (ion < 0.0))\n"
"    {\n"
"        best_alpha = alpha_deg;\n"
"        best_beta  = beta_deg;\n"
"        best_Vdc   = Vdc;\n"
"        break;\n"
"    }\n"
"}\n"
"\n"
"// Outputs to DEMUX\n"
"OutputSignal(0,0) = best_alpha;   // alpha in degree\n"
"OutputSignal(0,1) = best_beta;    // beta in degree\n"
"OutputSignal(0,2) = best_Vdc;     // required Vdc in volt"
            Show          off
          }
          Parameter {
            Variable      "UpdateFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "DerivativeFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "TerminateFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "StoreCustomStateFcn"
            Value         ""
            Show          off
          }
