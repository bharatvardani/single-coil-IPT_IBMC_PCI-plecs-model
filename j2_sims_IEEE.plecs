            Show          off
          }
          Parameter {
            Variable      "NumContStates"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "NumDiscStates"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "NumZCSignals"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "DirectFeedthrough"
            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "Ts"
            Value         "1/85e3"
            Show          off
          }
          Parameter {
            Variable      "TerminalBasedSampleTimes"
            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "Parameters"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "LangStandard"
            Value         "2"
            Show          off
          }
          Parameter {
            Variable      "GnuExtensions"
            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "RuntimeCheck"
            Value         "2"
            Show          off
          }
          Parameter {
            Variable      "HighlightLevel"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "Declarations"
            Value         "#include <math.h>\n"
"\n"
"#define PI 3.14159265358979323846\n"
"\n"
"static double harmonic_H(double alpha, double V, double X)\n"
"{\n"
"    double H = 0.0;\n"
"    double coeff;\n"
"    double s;\n"
"    int n;\n"
"\n"
"    for (n = 3; n <= 31; n += 2)\n"
"    {\n"
"        coeff = ((double)(n*n - 1))/((double)(n*n*(n*n - 2)));\n"
"        s = sin(n*alpha/2.0);\n"
"        H += coeff*s*s;\n"
"    }\n"
"\n"
"    H = (4.0*V/(PI*X))*H;\n"
"\n"
"    return H;\n"
"}"
            Show          off
          }
          Parameter {
            Variable      "StartFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "OutputFcn"
            Value         "// ================================================"
"======\n"
"// Inputs from MUX\n"
"// InputSignal(0,0) = Po      [W]\n"
"// InputSignal(0,1) = k\n"
"// InputSignal(0,2) = Vb      [V]\n"
"// InputSignal(0,3) = X1      [ohm]\n"
"// InputSignal(0,4) = X2      [ohm]\n"
"// InputSignal(0,5) = wLpt    [ohm]\n"
"// InputSignal(0,6) = wLst    [ohm]\n"
"//\n"
"// Outputs to DEMUX\n"
"// OutputSignal(0,0) = alpha1 [degree]\n"
"// OutputSignal(0,1) = alpha2 [degree]\n"
"// OutputSignal(0,2) = beta   [degree]\n"
"// OutputSignal(0,3) = Vdc    [V]\n"
"// ======================================================\n"
"\n"
"double Po   = InputSignal(0,0);\n"
"double k    = InputSignal(0,1);\n"
"double Vb   = InputSignal(0,2);\n"
"double X1   = InputSignal(0,3);\n"
"double X2   = InputSignal(0,4);\n"
"double wLpt = InputSignal(0,5);\n"
"double wLst = InputSignal(0,6);\n"
"\n"
"double c1 = 2.0*sqrt(2.0)/PI;   // 0.9003\n"
"\n"
"double beta_deg;\n"
"double beta;\n"
"\n"
"double Vdc;\n"
"double Vdc_min  = 600.0;\n"
"double Vdc_max  = 900.0;\n"
"double Vdc_step = 1.0;\n"
"\n"
"double S;\n"
"double Ipt1;\n"
"double Ist1;\n"
"\n"
"double Vpi1;\n"
"double Vsi1;\n"
"\n"
"double arg1;\n"
"double arg2;\n"
"\n"
"double alpha1;\n"
"double alpha2;\n"
"double alpha1_deg;\n"
"double alpha2_deg;\n"
"\n"
"double Hp;\n"
"double Hs;\n"
"\n"
"double ipi_on;\n"
"double ipi_off;\n"
"double isi_on;\n"
"double isi_off;\n"
"\n"
"double best_alpha1 = 0.0;\n"
"double best_alpha2 = 0.0;\n"
"double best_beta   = 0.0;\n"
"double best_Vdc    = 0.0;\n"
"\n"
"int found = 0;\n"
"\n"
"// Basic input checks\n"
"if ((Po <= 0.0) || (k <= 0.0) || (Vb <= 0.0) ||\n"
"    (X1 <= 0.0) || (X2 <= 0.0) || (wLpt <= 0.0) || (wLst <= 0.0))\n"
"{\n"
"    OutputSignal(0,0) = 0.0;\n"
"    OutputSignal(0,1) = 0.0;\n"
"    OutputSignal(0,2) = 0.0;\n"
"    OutputSignal(0,3) = 0.0;\n"
"}\n"
"else\n"
"{\n"
"    // Sweep beta from 90 deg to 170 deg\n"
"    for (beta_deg = 90.0; beta_deg <= 170.0; beta_deg += 0.05)\n"
"    {\n"
"        beta = beta_deg*PI/180.0;\n"
"\n"
"        if (sin(beta) <= 0.0)\n"
"        {\n"
"            continue;\n"
"        }\n"
"\n"
"        // Equal kVA condition:\n"
"        // Po = k*S*sin(beta), where S = VAp = VAs\n"
"        S = Po/(k*sin(beta));\n"
"\n"
"        if (S <= 0.0)\n"
"        {\n"
"            continue;\n"
"        }\n"
"\n"
"        // Fundamental pad currents\n"
"        Ipt1 = sqrt(S/wLpt);\n"
"        Ist1 = sqrt(S/wLst);\n"
"\n"
"        // Required fundamental voltages\n"
"        Vpi1 = X1*Ipt1;\n"
"        Vsi1 = X2*Ist1;\n"
"\n"
"        // Sweep Vdc from 600 V to 900 V\n"
"        for (Vdc = Vdc_min; Vdc <= Vdc_max; Vdc += Vdc_step)\n"
"        {\n"
"            // Primary three-level condition:\n"
"            // Vpi1 = 0.9003*Vdc*sin(alpha1/2)\n"
"            arg1 = Vpi1/(c1*Vdc);\n"
"\n"
"            // Secondary three-level condition:\n"
"            // Vsi1 = 0.9003*Vb*sin(alpha2/2)\n"
"            arg2 = Vsi1/(c1*Vb);\n"
"\n"
"            // Feasibility check\n"
"            if ((arg1 > 1.0) || (arg2 > 1.0))\n"
"            {\n"
"                continue;\n"
"            }\n"
"\n"
"            alpha1 = 2.0*asin(arg1);\n"
"            alpha2 = 2.0*asin(arg2);\n"
"\n"
"            alpha1_deg = alpha1*180.0/PI;\n"
"            alpha2_deg = alpha2*180.0/PI;\n"
"\n"
"            // Harmonic current terms\n"
"            Hp = harmonic_H(alpha1, Vdc, X1);\n"
"            Hs = harmonic_H(alpha2, Vb,  X2);\n"
"\n"
"            // ======================================================\n"
"            // Current direction: coming out of each inverter\n"
"            //\n"
"            // Primary current:\n"
"            // Switching instants:\n"
"            // theta_pi_on  = -alpha1/2\n"
"            // theta_pi_off = +alpha1/2\n"
"            //\n"
"            // Secondary current:\n"
"            // Switching instants:\n"
"            // theta_si_on  = beta - alpha2/2\n"
"            // theta_si_off = beta + alpha2/2\n"
"            //\n"
"            // Required polarity used here:\n"
"            // ipi_on  < 0, ipi_off > 0\n"
"            // isi_on  < 0, isi_off > 0\n"
"            // ======================================================\n"
"\n"
"            ipi_on  =  (sqrt(2.0)*Vsi1/X1)*sin(beta + alpha1/2.0) - Hp;\n"
"            ipi_off =  (sqrt(2.0)*Vsi1/X1)*sin(beta - alpha1/2.0) + Hp;\n"
"\n"
"            isi_on  = -(sqrt(2.0)*Vpi1/X2)*sin(beta - alpha2/2.0) - Hs;\n"
"            isi_off = -(sqrt(2.0)*Vpi1/X2)*sin(beta + alpha2/2.0) + Hs;\n"
"\n"
"            // Select first feasible operating point\n"
"            if ((ipi_on <= 0.0) && (ipi_off > 0.0) &&\n"
"                (isi_on < 0.0) && (isi_off >= 0.0))\n"
"            {\n"
"                best_alpha1 = alpha1_deg;\n"
"                best_alpha2 = alpha2_deg;\n"
"                best_beta   = beta_deg;\n"
"                best_Vdc    = Vdc;\n"
"\n"
"                found = 1;\n"
"                break;\n"
"            }\n"
"        }\n"
"\n"
"        if (found == 1)\n"
"        {\n"
"            break;\n"
"        }\n"
"    }\n"
"\n"
"    // Outputs\n"
"    OutputSignal(0,0) = best_alpha1;\n"
"    OutputSignal(0,1) = best_alpha2;\n"
"    OutputSignal(0,2) = best_beta;\n"
"    OutputSignal(0,3) = best_Vdc;\n"
"}"
            Show          off
          }
          Parameter {
            Variable      "UpdateFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "DerivativeFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "TerminateFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "StoreCustomStateFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "RestoreCustomStateFcn"
            Value         ""
            Show          off
          }
        }
