"{Ucs[ind[0]]=a; Ucs[ind[1]]=a;}\n"
"else\n"
"{Ucs[ind[0]]=b; Ucs[ind[1]]=b;}\n"
"  \n"
" Ucs1=Ucs[0];\n"
" Ucs2=Ucs[1];\n"
" Output(0)=Ucs1;\n"
" Output(1)=Ucs2;\n"
