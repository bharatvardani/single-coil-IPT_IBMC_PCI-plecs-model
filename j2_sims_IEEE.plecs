"#include <math.h>\n"
"\n"
"#define Uc1 Input(0)\n"
"#define Uc2 Input(1)\n"
"#define Uc3 Input(2)\n"
"#define a Input(3)\n"
"#define c Input(4)\n"
"\n"
"\n"
"float arr[2][2];\n"
"int ind[2]; \n"
"double Ucs[2];\n"
"float temp1=0;\n"
"//float a=1;\n"
"float b=0;\n"
"//float c=0.6;\n"
"\n"
"double Ucs1;\n"
"double Ucs2;\n"
"\n"
