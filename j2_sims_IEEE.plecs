                  Parameter {
                    Variable      "StartFcn"
                    Value         ""
                    Show          off
                  }
                  Parameter {
                    Variable      "OutputFcn"
                    Value         "\n"
"for ( int i=0; i<2; i++)\n"
"{arr[i][0]=Input(i);\n"
"}\n"
"\n"
"for ( int i=0; i<2; i++)\n"
"{arr[i][1]=i;\n"
"}\n"
"\n"
" \tfor ( int i=0; i<2; i++) ind[i]=i;\n"
" \tfor (int i=0; i<1; i++)\n"
" \tfor (int j=i+1; j<2; j++)\n"
" \tif ( arr[ind[i]][0]>arr [ind[j]][0])\n"
" \t{ temp1=ind[i]; ind[i]=ind [j]; ind[j]=temp1;}\n"
"\n"
"if (Input(2)==1)\n"
"{Ucs[ind[0]]=c+0.05; Ucs[ind[1]]=c-0.05;}\n"
"else if (Input(2)==2)\n"
"{Ucs[ind[0]]=a; Ucs[ind[1]]=c;}\n"
